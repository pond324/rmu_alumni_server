// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma/client"
  previewFeatures = ["schemaEngineDriverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model roles {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model regis_alumni {
  id               Int     @id @default(autoincrement())
  alumni_id        String? @unique
  alumni           alumni? @relation(fields: [alumni_id], references: [alumni_id])
  email            String
  tel              String
  slip_payment_url String
  isApproved       String  @default("pending")

  status String @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model alumni {
  alumni_id      String  @id @unique
  prefix         String
  fname          String
  lname          String
  profile        String?
  passwordHash   String?
  allowedAccount Boolean @default(false)
  canUse         Boolean @default(true)
  year_start     String?
  year_end       String?

  facultyId    String?
  departmentId String?
  edu_levelId  String?
  otp          otp?

  work_expreriences  work_expreriences[]
  study_expreriences studey_expreriences[]
  user_privacy       user_privacy?

  createtAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now())
  alumni_contract  alumni_contract?
  regis_alumni     regis_alumni?
  importHistory    import_history?   @relation(fields: [import_historyId], references: [id])
  import_historyId String?
  sendTextHistory  sendTextHistory[]
  faculty          faculty?          @relation(fields: [facultyId], references: [faculty_id])
  stdDepartments   std_departments?  @relation(fields: [departmentId], references: [department_id])
  eduLevel         edu_level?        @relation(fields: [edu_levelId], references: [edu_levelId])
}

model alumni_contract {
  id       Int     @id @default(autoincrement())
  alumniId String? @unique
  alumni   alumni? @relation(fields: [alumniId], references: [alumni_id])

  phone1   String?
  phone2   String?
  email1   String?
  email2   String?
  facebook String?

  address               String?
  tambon                String?
  amphure               String?
  province              String?
  zipcode               String?
  createtAt             DateTime   @default(now())
  updatedAt             DateTime   @default(now())
  professor             professor? @relation(fields: [professorProfessor_id], references: [professor_id])
  professorProfessor_id String?
}

model work_expreriences {
  id                 Int      @id @default(autoincrement())
  isOnTheLine        Boolean?
  job_position       String?
  company_name       String?
  company_place      String
  start_date         String?
  end_date           String?
  job_detail         String?
  job_responsibility String?
  job_skills         String?
  salary             Float?
  isCurrent          Boolean  @default(false)
  isInThai           Boolean  @default(true)
  remark             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  alumniId String?
  alumni   alumni? @relation(fields: [alumniId], references: [alumni_id])
}

model studey_expreriences {
  id              Int     @id @default(autoincrement())
  edu_level       String?
  continued_study Boolean @default(false)
  edu_faculty     String?
  edu_dep         String?
  edu_university  String?
  year_start      String?
  year_end        String?
  edu_performance String?
  isCurrent       Boolean @default(false)
  isInThai        Boolean @default(true)
  place           String?
  remark          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  alumniId String?
  alumni   alumni? @relation(fields: [alumniId], references: [alumni_id])
}

model user_privacy {
  id Int @id @default(autoincrement())

  seeEmail           Boolean  @default(false)
  seePhone           Boolean  @default(false)
  seeFacebook        Boolean  @default(false)
  seeAddress         Boolean  @default(false)
  seeWorkExprerience Boolean? @default(false)
  seeProfile         Boolean  @default(false)
  seeSalary          Boolean  @default(false)

  allowedAlumniSendEmail    Boolean  @default(false)
  allowedProfessorSendEmail Boolean? @default(true)

  alumniId    String?    @unique
  alumni      alumni?    @relation(fields: [alumniId], references: [alumni_id])
  professorId String?    @unique
  professor   professor? @relation(fields: [professorId], references: [professor_id])

  createtAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model professor {
  professor_id        String  @id @unique
  prefix              String
  fname               String
  lname               String
  profile             String?
  passwordHash        String?
  academic_rank       String?
  canUse              Boolean @default(true)
  univercity_position String?
  allowedAccount      Boolean @default(false)
  email               String?
  otp                 otp?

  sendTextHistory sendTextHistory[]

  facultyId    String?
  faculty      faculty? @relation(fields: [facultyId], references: [faculty_id])
  departmentId String?

  user_privacy     user_privacy?
  alumni_contract  alumni_contract[]
  importHistory    import_history?   @relation(fields: [import_historyId], references: [id])
  import_historyId String?

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now())
  stdDepartments std_departments? @relation(fields: [departmentId], references: [department_id])
}

model admin {
  admin_id     String    @id @unique @default(uuid())
  prefix       String
  fname        String
  lname        String
  username     String    @unique
  profile      String?
  passwordHash String
  canUse       Boolean   @default(true)
  email        String?
  tel          String?
  lastestLogin DateTime?

  sendTextHistory sendTextHistory[]

  otp           otp?
  importHistory import_history[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model sendTextHistory {
  id            Int      @id @default(autoincrement())
  alumni_sender String?
  alumniId      String?
  professorId   String?
  sender_type   String?  @default("admin")
  adminId       String?
  title         String
  detail        String
  category      String?
  createdAt     DateTime @default(now())

  professor professor? @relation(fields: [professorId], references: [professor_id])
  admin     admin?     @relation(fields: [adminId], references: [admin_id])
  alumni    alumni?    @relation(fields: [alumni_sender], references: [alumni_id])
}

model otp {
  id          Int      @id @default(autoincrement())
  code        String
  alumniId    String?  @unique
  professorId String?  @unique
  adminId     String?  @unique
  createdAt   DateTime @default(now())

  professor professor? @relation(fields: [professorId], references: [professor_id])
  admin     admin?     @relation(fields: [adminId], references: [admin_id])
  alumni    alumni?    @relation(fields: [alumniId], references: [alumni_id])
}

model news_donatios {
  id            Int     @id @default(autoincrement())
  title         String
  short_detail  String
  thumnail      String
  detail        String
  category      String
  target_money  Int?
  current_money Int?
  donate_end    String?
  isPublish     Boolean
  date          String
  month         String
  year          String
  view          Int

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model import_history {
  id         String @id @default(cuid())
  file_name  String
  file_size  Int?
  total_rows Int

  import_type String // alumni, student, employee  // pending, processing, completed, failed

  imported_by String
  admin       admin  @relation(fields: [imported_by], references: [admin_id])

  alumni      alumni[]
  professor   professor[]
  started_at  DateTime
  finished_at DateTime?

  created_at DateTime @default(now())
}

model faculty {
  faculty_id   String @id @unique
  faculty_name String

  createdAt  DateTime          @default(now())
  department std_departments[]
  alumni     alumni[]
  professors professor[]
}

model std_departments {
  department_id   String      @id @unique
  department_name String
  faculty_id      String
  faculty         faculty     @relation(fields: [faculty_id], references: [faculty_id])
  createdAt       DateTime    @default(now())
  alumni          alumni[]
  professors      professor[]
}

model edu_level {
  edu_levelId    String   @id @unique
  edu_level_name String
  createdAt      DateTime @default(now())
  alumni         alumni[]
}

model setting {
  id                           Int     @id @default(autoincrement())
  regis_payment_qrcode         String?
  regis_payment                Int?
  fac_sheet_link               String?
  dep_sheet_link               String?
  regis_payment_account_name   String?
  regis_payment_account_number String?
  regis_payment_account_back   String?
  skipAlumniDuplicate          Boolean @default(true)
  skipPersonelDuplicate        Boolean @default(true)
  allowedAlumniAccount         Boolean @default(true)
  allowedPersonelAccount       Boolean @default(true)
  allowedAdminAccount          Boolean @default(true)
  allowedNotifyAlumniRegis     Boolean @default(true)
  allowedNotifyAlumniEditRegis Boolean @default(true)
  notify_email                 String?
  backup_folderid              String?
  filebackup_folderid          String?
}
